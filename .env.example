# Copy to .env for local development. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose.yml's db service)
DB_NAME=rootpulse
DB_USER=rootpulse
DB_PASSWORD=rootpulse
DB_HOST=localhost
DB_PORT=5432

# Frontend origin(s) allowed to call this API — comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# GitHub OAuth (Phase 3)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Resend (Phase 8)
RESEND_API_KEY=

# Shared secret between the scheduler and the regional probers (Phase 6)
PROBER_SHARED_SECRET=
