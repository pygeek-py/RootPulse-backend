# Copy to .env for local development. Never commit the real .env.

# 32+ random characters; production refuses to start with a weak key.
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches docker-compose.yml's db service)
DB_NAME=rootpulse
DB_USER=rootpulse
DB_PASSWORD=rootpulse
DB_HOST=localhost
DB_PORT=5432

# Frontend origin(s) allowed to call this API — comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Where the frontend lives: OAuth lands here and password-reset links point here.
FRONTEND_URL=http://localhost:3000

# GitHub OAuth (Phase 3) — create an OAuth App at github.com/settings/developers
# with this callback URL. Leave blank to disable "Continue with GitHub".
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback/

# Reverse proxies in front of the app (Render = 1). Keeps per-IP rate limits
# from being dodged with a spoofed X-Forwarded-For. 0 locally.
NUM_PROXIES=0

# Email. Leave EMAIL_HOST blank and sign-in emails print in the server console.
# Set it and they are really sent over SMTP.
#
#   Gmail (easiest for local testing; needs 2-Step Verification on, then an
#   App Password from myaccount.google.com/apppasswords, NOT your normal password):
#     EMAIL_HOST=smtp.gmail.com
#     EMAIL_PORT=587
#     EMAIL_HOST_USER=you@gmail.com
#     EMAIL_HOST_PASSWORD=<16-char app password>
#     DEFAULT_FROM_EMAIL=RootPulse <you@gmail.com>
#
#   Resend (production): EMAIL_HOST=smtp.resend.com, EMAIL_HOST_USER=resend,
#     EMAIL_HOST_PASSWORD=<API key>, DEFAULT_FROM_EMAIL on a verified domain.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RootPulse <noreply@rootpulse.dev>

# Resend API (Phase 8 alert emails)
RESEND_API_KEY=

# Web push (python manage.py generate_vapid_keys prints these).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# One-click connections. Every one is optional: a channel without its credentials just doesn't
# offer "Connect", and people can still paste a webhook URL / their own bot token.
# Telegram: ONE bot for the whole deployment, made with @BotFather. Locally the server polls
# for "Start" presses; in production set TELEGRAM_WEBHOOK_SECRET (any long random string) and run
# `python manage.py telegram_webhook set` once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Discord: https://discord.com/developers/applications -> OAuth2. Add the redirect
# <API_PUBLIC_URL>/api/v1/integrations/discord/callback/
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Slack: https://api.slack.com/apps -> OAuth & Permissions. Add the redirect
# <API_PUBLIC_URL>/api/v1/integrations/slack/callback/  (Slack requires https)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Monitoring engine (Phase 6).
# Signs the GitHub Actions call to /internal/run-due-checks/. Generate a long random string
# (python -c "import secrets; print(secrets.token_urlsafe(48))") and set the SAME value as the
# SCHEDULER_SHARED_SECRET secret in the GitHub repository.
SCHEDULER_SHARED_SECRET=
# Regional probers (Cloudflare Workers), optional: without them a failure is re-checked from
# this server instead of from other regions.  PROBER_URLS=tokyo=https://...workers.dev,fra=https://...
PROBER_URLS=
PROBER_SHARED_SECRET=
# A label for checks run by this API itself (shown in the UI as the region).
PRIMARY_REGION=local
# An incident links to a deploy of its monitor's tagged service that finished this many seconds before it.
DEPLOY_CORRELATION_WINDOW_SECONDS=300
# Dependency monitoring: how often a provider's public status feed is read (seconds).
# Tracked providers use the first, untracked ones the second. Optional.
PROVIDER_POLL_SECONDS=300
PROVIDER_IDLE_POLL_SECONDS=1800
# Raw checks are kept this many days, then only the analytics rollups remain.
CHECK_RETENTION_DAYS=90
# API's own public URL, used to build heartbeat ping URLs.
API_PUBLIC_URL=http://localhost:8000

# --- Production hardening (docs/plan/07-security-review.md) ---------------------------------
# Where the Django admin lives. Make it something unguessable in production.
DJANGO_ADMIN_URL=admin/
# (NUM_PROXIES above must be 1 behind Render's proxy, so per-address rate limits see real addresses.)
# Production redirects HTTP to HTTPS and sends HSTS for a year; both can be adjusted here.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# --- Deployment (docs/plan/09-deployment-runbook.md) -----------------------------------------
# One connection string instead of the DB_* values above (Neon gives you one). SSL is required.
DATABASE_URL=
# Render fills this in itself; list any custom domain in DJANGO_ALLOWED_HOSTS.
# RENDER_EXTERNAL_HOSTNAME=
# "None" when the website and API are on different sites; "Lax" when the website proxies the API.
# AUTH_REFRESH_COOKIE_SAMESITE=None
# RootPulse is single-owner. Leave true until YOUR account exists, then set false so strangers
# can't create accounts on your deployment (existing accounts still sign in).
SIGNUPS_OPEN=true
# Error tracking (optional; Sentry free plan). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO
# gunicorn (the defaults suit Render's free instance).
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=170
# Set to false to start without running migrations first.
RUN_MIGRATIONS=true

# --- Limits and tuning (all optional; the defaults are what production uses) ------------------
CHECK_WORKERS=20
CHECK_BATCH_SIZE=100
CHECK_PASS_BUDGET_SECONDS=80
# The whole scheduler call (checks, dependency reads, alerts, mail) aims to finish inside this.
TRIGGER_BUDGET_SECONDS=110
CHECK_RECHECK_DELAY_SECONDS=5
CHECK_TCP_TIMEOUT=10
NOTIFY_WORKERS=8
NOTIFY_BATCH_SIZE=100
STATUS_PAGE_MAIL_WORKERS=4
MAX_MONITORS_PER_USER=50
MAX_ALERT_CONTACTS_PER_USER=20
MAX_DEPLOY_SOURCES_PER_USER=10
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Overrides the email backend entirely (normally chosen from EMAIL_HOST).
# EMAIL_BACKEND=
